<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd"
  logicalFilePath="changelog-optinexus-events">

  <changeSet author="optinexus" id="changelog-optinexus-events">

    <createTable tableName="tc_optinexus_events">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="eventuuid" type="VARCHAR(36)">
        <constraints nullable="false" unique="true" />
      </column>
      <column name="eventkey" type="VARCHAR(150)">
        <constraints nullable="false" />
      </column>
      <column name="tenantid" type="VARCHAR(36)">
        <constraints nullable="false" />
      </column>
      <column name="deviceid" type="BIGINT" />
      <column name="sourceeventid" type="BIGINT" />
      <column name="occurredat" type="TIMESTAMP">
        <constraints nullable="false" />
      </column>
      <column name="payload" type="VARCHAR(4000)">
        <constraints nullable="false" />
      </column>
      <column name="status" type="VARCHAR(16)">
        <constraints nullable="false" />
      </column>
      <column name="attempts" type="INT">
        <constraints nullable="false" />
      </column>
      <column name="lastattemptedat" type="TIMESTAMP" />
      <column name="lasterror" type="VARCHAR(1000)" />
      <column name="deliveredat" type="TIMESTAMP" />
      <column name="createdat" type="TIMESTAMP">
        <constraints nullable="false" />
      </column>
    </createTable>

    <createIndex indexName="tc_optinexus_events_status_idx" tableName="tc_optinexus_events">
      <column name="status" />
      <column name="id" />
    </createIndex>

  </changeSet>

</databaseChangeLog>
