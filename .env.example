# OptiRadar container runtime: copy to .env (never commit it). Compose reads this file for ${...} interpolation only; the container gets
# exactly the values passed in docker-compose.yml. After changing a value run `docker compose up -d`; no image rebuild is needed.
#
# Required (Compose refuses to start without it):
RADAR_DB_PASSWORD=

# Origin the browser uses for OptiRadar Web (also the OpenID redirect origin: <origin>/api/session/openid/callback).
RADAR_PUBLIC_URL=http://localhost:8082

# Host port and the address it is published on (127.0.0.1 = this machine only).
BIND_ADDRESS=127.0.0.1
RADAR_PORT=8082

# --- OptiNexus (leave empty to run OptiRadar on its own with password sign-in)
# Must be the OIDC issuer exactly as OptiNexus publishes it, reachable from this container and from the browser.
OPTINEXUS_BASE_URL=
OPTINEXUS_SSO_CLIENT_ID=
OPTINEXUS_SSO_CLIENT_SECRET=
OPTINEXUS_EVENTS_ENABLE=false
OPTINEXUS_SERVICE_CLIENT_ID=
OPTINEXUS_SERVICE_CLIENT_SECRET=
OPTINEXUS_ENTITLEMENTS_ENFORCE=false

# Origins that may frame OptiRadar Web (space separated), for example the OptiDeli console http://deli.localtest.me:5200
WEB_FRAME_ANCESTORS=

# Optional
RADAR_DB_NAME=optiradar
RADAR_DB_USER=optiradar
